# Copy to .env and fill in. .env is gitignored — never commit real keys.

# local (default, offline) | openrouter (sends transcript text to OpenRouter — see
# skills/prime-directive.md for the offline-constraint exception this represents)
SUMMARIZER_BACKEND=local

OPENROUTER_API_KEY=
# named free model slugs on OpenRouter rotate/get deprecated frequently (verified 2026-08-27:
# meta-llama/llama-3.3-70b-instruct:free was pulled from free tier within the same day it was
# checked). Use the auto-router instead — it always resolves to *some* current free model:
OPENROUTER_MODEL=openrouter/free
